# SOC-EYE RAG pipeline — SERVER configuration (172.16.212.229).
# Copy to /opt/soceye-rag/.env and fill LLM_API_KEY. Never commit the result.

# --- MongoDB: local on this host, same DB the Node backend uses -------------
MONGODB_URI="mongodb://127.0.0.1:27017/test"
DB_NAME="test"

# --- Generation: the Ollama already running on this host --------------------
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
# NOTE: this host currently serves plain `qwen2.5:7b`, whose default context is
# 4096 and silently truncates RAG prompts (system instructions included).
# Create the 8k variant from a Modelfile before starting the API:
#   printf 'FROM qwen2.5:7b\nPARAMETER num_ctx 8192\n' > /tmp/Modelfile
#   ollama create qwen2.5-7b-8k -f /tmp/Modelfile
LLM_MODEL=qwen2.5-7b-8k:latest
LLM_MAX_CONTEXT=8192

# --- Embeddings: local Nomic on this host's GPU -----------------------------
EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBED_DIM=768
EMBED_DEVICE=auto
EMBED_BATCH_SIZE=0
EMBED_MAX_LENGTH=1024
EMBED_BATCH_AT_1024=8
# Leave unset on the first deploy so the weights (~520 MB) can download.
# Set to 1 afterwards to pin the host to its local cache.
# HF_HUB_OFFLINE=1

# --- Background sync --------------------------------------------------------
# MUST stay false until deploy/run_embeddings.sh has finished. Enabling it over
# the current corpus writes nomic vectors alongside the old model's, producing a
# mixed corpus in which newer documents outrank older ones as a scoring artifact.
INGEST_SCHEDULER_ENABLED=false
INGEST_INTERVAL_HOURS=8
INGEST_COLLECTIONS=alerts,grievances,pois,sources,events,keywords,dailyprogrammes,dial100incidents,telegrammessages,criticism_reports,suggestion_reports,grievance_workflow_reports

# Collections the rebuild embeds. Deliberately excludes contents (2.0M chunks),
# analyses (646K), retweetrelationships (440K), temp_content (300K) and
# auditlogs (217K): the assistant never queries them, and including them turns a
# ~3.5 h rebuild into a ~60 h one.
EMBED_COLLECTIONS=alerts,grievances,pois,sources,events,keywords,dailyprogrammes,dial100incidents,telegrammessages,criticism_reports,suggestion_reports,grievance_workflow_reports,legalsections,platformpolicies,policymappings,query_reports

# --- Retrieval scope --------------------------------------------------------
# Every collection listed here is loaded into the API process's RAM in full on
# first use and never released. Keep it to what the assistant actually answers
# from: this list is ~371K chunks (~1.1 GB). Adding `contents` alone adds 2.0M
# chunks (~5.9 GB) and a brute-force query cost of minutes.
ALLOWED_QUERY_COLLECTIONS=alerts,grievances,pois,sources,events,keywords,dailyprogrammes,dial100incidents,telegrammessages,criticism_reports,suggestion_reports,grievance_workflow_reports,legalsections,platformpolicies,policymappings,query_reports
